# ===== COMMON =========
GITHUB_READONLY_TOKEN=token
LAB_IP=192.168.X.X
BASE_DOMAIN=example.com

# ===== Portainer ======
PORTAINER_HTTPS_PORT=9443
PORTAINER_EDGE_PORT=8000

# ===== MC Aggregator
MC_AGGREGATOR_PORT=5000
MC_AGGREGATOR_IP=${LAB_IP}:${MC_AGGREGATOR_PORT}
MC_AGGREGATOR_DOMAIN=mcstatus.${BASE_DOMAIN}
MC_AGGREGATOR_URL=http://${MC_AGGREGATOR_IP}
MC_AGGREGATOR_DOMAIN_URL=https://${MC_AGGREGATOR_DOMAIN}
MC_AGGREGATOR_ICON=https://raw.githubusercontent.com/homarr-labs/dashboard-icons/refs/heads/main/svg/minecraft.svg
MC_AGGREGATOR_SERVERS=mc.example.com